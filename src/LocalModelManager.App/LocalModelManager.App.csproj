<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF><PlatformTarget>x64</PlatformTarget><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><ProjectReference Include="../LocalModelManager.Infrastructure/LocalModelManager.Infrastructure.csproj" /></ItemGroup>
  <PropertyGroup>
    <StartupObject>LocalModelManager.App.App</StartupObject>
    <Version>0.6.0</Version>
    <GitHubRepositoryUrl Condition="'$(GitHubRepositoryUrl)' == ''">https://github.com/michailr1/Model-Manager-LMM-</GitHubRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <AssemblyMetadata Include="GitHubRepositoryUrl" Value="$(GitHubRepositoryUrl)" />
  </ItemGroup>
</Project>
